# WhatsApp number in international format, digits only (no +, spaces or dashes)
VITE_WHATSAPP_NUMBER=923117503005

# Meta (Facebook) Pixel ID for ad conversion tracking (leave empty to disable)
VITE_META_PIXEL_ID=

# Public site URL, used for SEO tags
VITE_SITE_URL=https://www.example.com

# ------------------------------------------------------------------
# Booking (server-side only: never prefix these with VITE_)
# Set the same names in Cloudflare Pages → Settings → Variables and Secrets.
# ------------------------------------------------------------------

# Google Calendar + Meet. Create an OAuth client (Desktop app) and run: npm run google:auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Calendar that receives bookings ("primary" = the owner's main calendar)
GOOGLE_CALENDAR_ID=primary

# Confirmation emails via Resend (resend.com). EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Mualim Ul Furqan <bookings@yourdomain.com>"
# Owner notification address
OWNER_EMAIL=mualimulfurqan@gmail.com
